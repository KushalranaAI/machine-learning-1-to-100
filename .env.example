# Copy this file to ".env" in the repository root and fill in the provider(s) you use. No restart needed.
#
# These keys are read by the local app on YOUR computer and attached to AI requests there. The browser never
# receives them, nothing is stored in the browser, and nothing here is bundled into the app.
# Never rename them with a NEXT_PUBLIC_ prefix: that would publish them in the page's JavaScript.
# Only works when you run the app locally (python start.py), not on the hosted GitHub Pages copy.
#
# ".env" is git-ignored. Never commit it.

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Azure OpenAI (endpoint, deployment and key are all needed; the version is optional)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
